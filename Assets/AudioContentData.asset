  - _clip: {fileID: 8300000, guid: 6637f51f1d9c5b74ba93cd20de619889, type: 3}
    _volume: 0.467
  panelText: "\u0416\u0438\u043B-\u0431\u044B\u043B \u043F\u0435\u043A\u0430\u0440\u044C,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0442\u0430\u043A \u0432\u0435\u0440\u0438\u043B
    \u0432 \u0441\u0438\u043B\u0443 \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u043E\u0433\u043E
    \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F, \u0447\u0442\u043E \u0434\u0430\u0436\u0435
    \u043A\u043E\u0433\u0434\u0430 \u0432 \u0442\u0435\u0441\u0442\u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
    \u043F\u043E\u043F\u0430\u043B \u043A\u043B\u044E\u0447 \u043E\u0442 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B,
    \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u0417\u0430\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C
    \u0443 \u0432\u044B\u043F\u0435\u0447\u043A\u0438 \u0442\u043E\u0447\u043D\u043E
    \u0435\u0441\u0442\u044C \u0434\u0443\u0448\u0430\xBB. \u0410 \u0441\u043E\u0441\u0435\u0434\u0438
    \u043F\u043E\u0442\u043E\u043C \u0435\u0449\u0451 \u043C\u0435\u0441\u044F\u0446
    \u0433\u0430\u0434\u0430\u043B\u0438, \u043F\u043E\u0447\u0435\u043C\u0443 \u0431\u0443\u043B\u043E\u0447\u043A\u0438
    \u0442\u0430\u043A \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E
    \u0441\u0442\u0443\u0447\u0430\u0442 \u0432 \u0434\u0432\u0435\u0440\u044C \u043F\u043E
    \u043D\u043E\u0447\u0430\u043C."
